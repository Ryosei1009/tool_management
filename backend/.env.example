# サーバー
PORT=4000

# HTTPS で起動する場合のみ設定（未設定なら HTTP で起動）
# KEY_PATH=./cert/privkey.pem
# CERT_PATH=./cert/fullchain.pem

# CORS 許可オリジン（カンマ区切り）
ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173,http://localhost:3000

# JWT
# 16 文字以上のランダムな文字列にする（ひな形のままでは起動しない）。例: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=tool_management

# 操作ログ（logs/access-YYYY-MM-DD.log）を残す日数。過ぎたものは自動で消す。
LOG_RETENTION_DAYS=90

# nginx などのリバースプロキシの後ろで動かすときは 1 にする（操作ログの IP が接続元のものになる）
# TRUST_PROXY=1
