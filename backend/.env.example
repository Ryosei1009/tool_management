# サーバー
PORT=4000

# HTTPS で起動する場合のみ設定（未設定なら HTTP で起動）
# KEY_PATH=./cert/privkey.pem
# CERT_PATH=./cert/fullchain.pem

# CORS 許可オリジン（カンマ区切り）
ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173,http://localhost:3000

# JWT
JWT_SECRET=change-me-to-a-long-random-string

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=tool_management
