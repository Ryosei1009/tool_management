# 本番（VPS）の /srv/tool/.env のひな形。cp deploy/env.vps.example .env && chmod 600 .env で作る（.env は Git に入れない）
# 使うのは compose.vps.yaml。PORT・TZ・TRUST_PROXY は compose.vps.yaml に書いてある

# MySQL（/srv/infra のもの。コンテナの名前 mysql でつながる）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=tool
MYSQL_PASSWORD=
MYSQL_DATABASE=tool_management

# ログインのトークンに署名する秘密鍵（16 文字以上）。
# Portfolio の .env の TM_JWT_SECRET と同じ値にすると、今ログインしている人はそのまま使える
JWT_SECRET=

# 画面のオリジン（ここからの通信だけ受け付ける）
ALLOWED_ORIGINS=https://tool.shinoryo.com

# 操作ログを残す日数
LOG_RETENTION_DAYS=90
