# docker compose 用の設定。.env にコピーして値を書き換える（.env は Git に入れない）。
#   cp .env.docker.example .env

# MySQL のパスワード（root 用と、アプリ用）
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ログインのトークンに署名する秘密鍵。16 文字以上のランダムな文字列にする。
#   作り方の例: openssl rand -hex 32
JWT_SECRET=

# 画面を公開するポート（http://<サーバー>:8080）
WEB_PORT=8080

# 操作ログを残す日数
LOG_RETENTION_DAYS=90

# 画面と API を別のホストで動かすときだけ、画面のオリジンをカンマ区切りで指定する
# ALLOWED_ORIGINS=https://tools.example.co.jp
